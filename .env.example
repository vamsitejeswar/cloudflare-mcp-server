# Cloudflare API token — create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone Analytics (Read), DNS (Read+Edit), Zone Rulesets (Read+Edit),
# Account Rulesets (Read), Billing (Read), Zone Settings (Read+Edit)
CLOUDFLARE_API_TOKEN=your-api-token-here

# Cloudflare account ID — found on the right sidebar of any zone's Overview page,
# or via: curl -H "Authorization: Bearer <token>" https://api.cloudflare.com/client/v4/accounts
# Used as the default account_id for account-scoped tools when not passed explicitly.
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Optional: override the server listen port (default: 8000)
# MCP_PORT=8000

# Optional: override the MCP HTTP path (default: /mcp)
# MCP_PATH=/mcp
